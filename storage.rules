rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/receipts/{fileName} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && fileName.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$')
        && request.resource.size > 0 && request.resource.size <= 1536 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)')
        && request.resource.metadata.ownerUid == uid
        && request.resource.metadata.transactionId is string
        && request.resource.metadata.transactionId.size() > 0
        && request.resource.metadata.transactionId.size() <= 128;
      allow update: if false;
      allow delete: if isOwner(uid);
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
